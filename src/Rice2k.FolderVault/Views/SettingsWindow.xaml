<Window x:Class="Rice2k.FolderVault.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Rice2k Folder Vault"
        Width="650"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Configure vault behavior and automatic locking."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,20"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Auto-Lock" FontSize="18" FontWeight="SemiBold"/>
                        <CheckBox x:Name="AutoLockEnabledCheckBox"
                                  Content="Enable automatic locking"
                                  Margin="0,14,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lock after" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AutoLockMinutesComboBox" Grid.Column="1" Height="32"/>
                        </Grid>

                        <CheckBox x:Name="LockWhenWindowsLocksCheckBox"
                                  Content="Lock when Windows locks"
                                  Margin="0,14,0,0"/>
                        <CheckBox x:Name="LockWhenSystemSleepsCheckBox"
                                  Content="Lock when the system sleeps or hibernates"
                                  Margin="0,9,0,0"/>
                        <CheckBox x:Name="LockWhenUserSignsOutCheckBox"
                                  Content="Lock when the user signs out"
                                  Margin="0,9,0,0"/>
                        <CheckBox x:Name="LockWhenScreensaverStartsCheckBox"
                                  Content="Lock when the screensaver starts"
                                  Margin="0,9,0,0"/>
                        <CheckBox x:Name="LockAtShutdownCheckBox"
                                  Content="Lock at shutdown or restart"
                                  Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold"/>
                        <CheckBox x:Name="OpenExplorerAfterUnlockCheckBox"
                                  Content="Mount and open the read-only Explorer drive after unlocking (alpha)"
                                  Margin="0,14,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Preferred drive letter" VerticalAlignment="Center"/>
                            <ComboBox x:Name="MountPointComboBox" Grid.Column="1" Height="32"/>
                        </Grid>

                        <CheckBox x:Name="ShowWarningBeforeLockCheckBox"
                                  Content="Show warning before automatic locking"
                                  Margin="0,9,0,0"/>
                        <TextBlock Text="Windows lock, sleep, and sign-out hooks are planned for a later milestone. These options are represented now so the final behavior can be wired in without redesigning the interface."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="3"
                    Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
