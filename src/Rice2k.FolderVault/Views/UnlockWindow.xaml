<Window x:Class="Rice2k.FolderVault.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock — Rice2k Folder Vault"
        Width="430"
        Height="405"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="72" Height="72" Background="#142A49" CornerRadius="18" HorizontalAlignment="Center">
                <TextBlock Text="LOCK" FontSize="13" FontWeight="Bold" Foreground="#69A7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Personal Vault is locked" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="Enter your password to unlock." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,25,0,0">
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <Grid>
                <PasswordBox x:Name="PasswordInput" Height="38" Padding="10,7"/>
                <TextBox x:Name="VisiblePasswordInput" Height="38" Padding="10,7" Visibility="Collapsed"/>
            </Grid>

            <CheckBox x:Name="ShowPasswordCheckBox"
                      Content="Show password"
                      Margin="0,10,0,0"
                      Checked="ShowPasswordCheckBox_Changed"
                      Unchecked="ShowPasswordCheckBox_Changed"/>

            <Border Background="#13253C" BorderBrush="#29496F" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,16,0,0">
                <TextBlock Text="Password verification is active. Encrypted file storage and drive mounting are still under development in this alpha."
                           TextWrapping="Wrap"
                           Foreground="#BFD8F7"
                           FontSize="12"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Unlock Vault" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockButton_Click"/>
        </Grid>
    </Grid>
</Window>
