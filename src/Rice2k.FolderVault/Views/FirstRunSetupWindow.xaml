<Window x:Class="Rice2k.FolderVault.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Vault Password — Rice2k Folder Vault"
        Width="470" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="76" Height="76" Background="#142A49" CornerRadius="20" HorizontalAlignment="Center">
                <TextBlock Text="VAULT" FontSize="12" FontWeight="Bold" Foreground="#69A7FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Secure your new Folder Vault" FontWeight="SemiBold" FontSize="23"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="Create the password required to unlock this vault."
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="Vault password" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <PasswordBox x:Name="PasswordInput" Height="40" Padding="10,7"/>

            <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="40" Padding="10,7"/>

            <TextBlock Text="Use at least 12 characters. This password is not stored in plain text."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Border Background="#13253C" BorderBrush="#29496F" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,18,0,0">
                <TextBlock Text="Important: this alpha now verifies your password using Argon2id, but encrypted file storage is not active yet. Do not place sensitive files in it until the encrypted vault engine is complete."
                           TextWrapping="Wrap" Foreground="#BFD8F7" FontSize="12"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Create Password" Style="{StaticResource PrimaryButtonStyle}" Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>