<Window x:Class="Rice2k.FolderVault.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Vault Password — Rice2k Folder Vault"
        Width="500"
        Height="535"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="72" Height="72"
                    Background="#142A49"
                    CornerRadius="18"
                    HorizontalAlignment="Center">
                <TextBlock Text="KEY"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#69A7FF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="VaultNameText"
                       Text="Change vault password"
                       FontSize="23"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>

            <TextBlock Text="The stored files will not be re-encrypted."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Current password" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <PasswordBox x:Name="CurrentPasswordInput" Height="40" Padding="10,7"/>

            <TextBlock Text="New password" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="NewPasswordInput" Height="40" Padding="10,7"/>

            <TextBlock Text="Confirm new password" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="40" Padding="10,7"/>

            <TextBlock Text="Use at least 12 characters."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,10,0,0"/>

            <Border Background="#13253C"
                    BorderBrush="#29496F"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,18,0,0">
                <TextBlock Text="Changing the password creates a new Argon2id-derived key and re-wraps the existing Vault Master Key. META and FILE ciphertext stays encrypted under the same master key."
                           TextWrapping="Wrap"
                           Foreground="#BFD8F7"
                           FontSize="12"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="2"
                    Content="Change Password"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ChangePasswordButton_Click"/>
        </Grid>
    </Grid>
</Window>
