<Window x:Class="Rice2k.FolderVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rice2k Folder Vault"
        Width="900"
        Height="585"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E192B" BorderBrush="#20314E" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="RICE2K" Foreground="#69A7FF" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="Folder Vault" FontWeight="Bold" FontSize="22" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Home" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"/>
                    <Button Content="Settings" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" Click="SettingsButton_Click"/>
                    <Button x:Name="VaultManagerButton" Content="Vault Contents" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Margin="0,0,0,10" Click="VaultManagerButton_Click"/>
                    <Button x:Name="ChangePasswordButton" Content="Change Password" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Margin="0,0,0,10" Click="ChangePasswordButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="v0.3.0-alpha" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="Read-only Explorer drive alpha" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34">
                <TextBlock x:Name="VaultNameText" Text="Personal Vault" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Encrypted storage control center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,24"/>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="78" Height="78" CornerRadius="18" Background="#132846" VerticalAlignment="Top">
                            <TextBlock Text="LOCK" FontSize="14" FontWeight="Bold" Foreground="#69A7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Status" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                                <Border x:Name="StatusBadge" Background="#5A2530" CornerRadius="12" Padding="10,3" Margin="12,0,0,0">
                                    <TextBlock x:Name="StatusText" Text="Locked" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="StatusDetailText"
                                       Text="Vault master key is not available in memory."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,9,0,0"/>

                            <TextBlock x:Name="AutoLockText"
                                       Text=""
                                       Foreground="#75AFFF"
                                       Margin="0,5,0,0"/>

                            <WrapPanel Margin="0,20,0,0">
                                <Button x:Name="UnlockButton" Content="Unlock Vault" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockButton_Click" Margin="0,0,10,8"/>
                                <Button x:Name="OpenVaultButton" Content="Vault Contents" Style="{StaticResource SecondaryButtonStyle}" Click="OpenVaultButton_Click" Margin="0,0,10,8" IsEnabled="False"/>
                                <Button x:Name="MountDriveButton" Content="Mount Explorer Drive" Style="{StaticResource PrimaryButtonStyle}" Click="MountDriveButton_Click" Margin="0,0,10,8" IsEnabled="False"/>
                                <Button x:Name="UnmountDriveButton" Content="Unmount Drive" Style="{StaticResource SecondaryButtonStyle}" Click="UnmountDriveButton_Click" Margin="0,0,10,8" IsEnabled="False"/>
                                <Button x:Name="LockButton" Content="Lock Now" Style="{StaticResource SecondaryButtonStyle}" Click="LockButton_Click" Margin="0,0,10,8" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Explorer Drive" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock x:Name="MountPointText" Text="V:" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="MountDetailText" Text="Not mounted" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Vault Engine" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="Encrypted file storage active" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="Read-only Explorer mount foundation added" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,18,0,0" Background="#17233A" BorderBrush="#2C4265" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="v0.3.0 alpha security notice" FontWeight="SemiBold"/>
                        <TextBlock Text="The .rvault header, metadata, and file records remain encrypted and authenticated. The v0.3 Explorer drive is intentionally read-only while mounted; writable filesystem transactions, crash hardening, recovery keys, and security review are not complete. Continue using disposable test data and backups."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
