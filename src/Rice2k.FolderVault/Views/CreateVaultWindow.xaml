<Window x:Class="Rice2k.FolderVault.Views.CreateVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Vault — Rice2k Folder Vault"
        Width="560" Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Create Rice2k Folder Vault" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Create a portable .rvault container and protect its master key with your password."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Vault name" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="VaultNameInput" Height="38" Padding="10,7" Text="Personal Vault"/>

            <TextBlock Text="Vault file" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VaultPathInput" Height="38" Padding="10,7"/>
                <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click"/>
            </Grid>

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="PasswordInput" Height="38" Padding="10,7"/>

            <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="38" Padding="10,7"/>

            <TextBlock Text="Use at least 12 characters. The password is used to derive a key that protects a random 256-bit vault master key."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <Border Background="#392F16" BorderBrush="#765F1B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                <TextBlock Text="v0.2 alpha: the vault header and master-key protection are active. Encrypted file payload storage and Explorer mounting are not active yet, so do not use this build for sensitive files."
                           TextWrapping="Wrap" Foreground="#F0CF72" FontSize="12"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Create Vault" Style="{StaticResource PrimaryButtonStyle}" Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>
