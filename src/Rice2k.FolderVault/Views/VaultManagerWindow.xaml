<Window x:Class="Rice2k.FolderVault.Views.VaultManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Contents — Rice2k Folder Vault"
        Width="940"
        Height="620"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="VaultTitleText" Text="Vault Contents" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Encrypted folder and file manager. Explorer mounting will replace this workflow in v0.3."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12"
                Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Up"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        Click="UpButton_Click"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Current folder" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock x:Name="CurrentPathText"
                               Text="\"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#13253C"
                BorderBrush="#29496F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,14">
            <TextBlock Text="Folder names, file names, hierarchy, sizes, timestamps, and content-record IDs are stored inside authenticated encrypted metadata. Double-click a folder to open it."
                       TextWrapping="Wrap"
                       Foreground="#BFD8F7"
                       FontSize="12"/>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="1">
            <ListView x:Name="EntryList"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      SelectionMode="Single"
                      MouseDoubleClick="EntryList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="Modified" Width="190" DisplayMemberBinding="{Binding Modified}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <WrapPanel Grid.Row="4" Margin="0,18,0,0">
            <Button Content="New Folder..." Style="{StaticResource PrimaryButtonStyle}" Click="NewFolderButton_Click" Margin="0,0,10,8"/>
            <Button Content="Add Files..." Style="{StaticResource PrimaryButtonStyle}" Click="AddFilesButton_Click" Margin="0,0,10,8"/>
            <Button Content="Export Selected..." Style="{StaticResource SecondaryButtonStyle}" Click="ExportButton_Click" Margin="0,0,10,8"/>
            <Button Content="Rename..." Style="{StaticResource SecondaryButtonStyle}" Click="RenameButton_Click" Margin="0,0,10,8"/>
            <Button Content="Delete..." Style="{StaticResource SecondaryButtonStyle}" Click="DeleteButton_Click" Margin="0,0,10,8"/>
            <Button Content="Compact Vault" Style="{StaticResource SecondaryButtonStyle}" Click="CompactButton_Click" Margin="0,0,10,8"/>
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" Margin="0,0,10,8"/>
            <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" Margin="0,0,0,8"/>
        </WrapPanel>
    </Grid>
</Window>